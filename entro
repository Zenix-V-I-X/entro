local function createButton(text, order)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0.35, 0, 1, 0)
    Button.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Button.Text = ""
    Button.ZIndex = 5
    Button.LayoutOrder = order
