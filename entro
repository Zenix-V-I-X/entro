        TweenService:Create(SolidBlackBG, fadeInfo, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(BlackBG, fadeInfo, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(BgCarousel, fadeInfo, { BackgroundTransparency = 1 }):Play()

        TweenService:Create(BlurEffect, TweenInfo.new(0.8, Enum.EasingStyle.Quad), { Size = 40 }):Play()

        task.delay(fadeTime, function()
            pcall(function() BlurEffect:Destroy() end)

            LogoFrame.Visible = false
            ButtonsHolder.Visible = false
            StarImage.Visible = false
            BgCarousel.Visible = false

            if musicPersistEnabled then
                SongTab.Visible = true
                SongTab.TextTransparency = 0
                SongTab.BackgroundTransparency = 0.15
                ReplaceToggleWithDelete()
            end

            task.spawn(function()
                if scriptType == "encrypt" then
                    loadstring(game:HttpGet(url))("9012111915890")
                else
                    loadstring(game:HttpGet(url))()
                end
            end)
        end)
    end)
end

