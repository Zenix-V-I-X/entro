local function toggleMenu(open)
    if isExiting then return end
    menuOpen = open
    local targetPosition = open and openPosition or closedPosition

    local easingStyle = open and Enum.EasingStyle.Back or Enum.EasingStyle.Quad
    local easingDirection = open and Enum.EasingDirection.Out or Enum.EasingDirection.In

    local tweenInfo = TweenInfo.new(0.6, easingStyle, easingDirection)
    local menuTween = TweenService:Create(DevMenu, tweenInfo, {Position = targetPosition})
    menuTween:Play()

    if open then
        local imageTarget = UDim2.new(0.5, -(IsMobile and 270 or 310) - 30, 0.5, 0)
        local imageAnchor = Vector2.new(0.5, 0.5)
        TweenService:Create(CenterImage, TweenInfo.new(0.6, easingStyle, easingDirection), {
            Position = imageTarget,
            AnchorPoint = imageAnchor
        }):Play()
    else
        TweenService:Create(CenterImage, TweenInfo.new(0.6, easingStyle, easingDirection), {
            Position = originalPosition,
            AnchorPoint = originalAnchor
        }):Play()
    end
end

