        RefreshSongToggles()
        SongTab.Visible = false
    end

    StarImage.ZIndex = 100
    StarImage.Visible = true
    StarImage.ImageTransparency = 0
    starStroke.Transparency = 0

    local moveTween = TweenService:Create(StarImage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position    = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
    })
    moveTween:Play()
    moveTween.Completed:Wait()

    TweenService:Create(starRotationSpeed, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Value = 720
    }):Play()

    TweenService:Create(StarImage, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 2000, 0, 2000)
    }):Play()

    task.delay(0.6, function()
        local fadeTime = 0.6
        local fadeInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        TweenService:Create(StarImage, fadeInfo, { ImageTransparency = 1 }):Play()
