local req = (syn and syn.request) or (http and http.request) or http_request or request
local function fetch(url)
    if req then
        local ok, r = pcall(req, {Url = url, Method = "GET"})
        if ok and r and (r.StatusCode == 200 or r.StatusCode == nil) and type(r.Body) == "string" and #r.Body > 8 then
            return r.Body
        end
    end
    local ok, b = pcall(game.HttpGet, game, url)
    if ok and type(b) == "string" and #b > 8 then return b end
    return nil
end

local audioSound = nil
local audioPath  = nil

local function StopAndDeleteMusic()
    pcall(function()
        if audioSound then
            audioSound:Stop()
            audioSound:Destroy()
            audioSound = nil
        end
        if audioPath and isfile(audioPath) then
            delfile(audioPath)
            audioPath = nil
        end
    end)
end

task.spawn(function()
    local folder = "Sounds"
    local fileName = tostring(os.time()) .. ".mp3"
    local soundPath = folder .. "/" .. fileName

    local assetFunc = getsynasset or getcustomasset
    if not assetFunc then return end

    pcall(function()
        if not isfolder(folder) then makefolder(folder) end
    end)

    local url = "https://www.dropbox.com/scl/fi/w1ens2pi12txhcct3wszt/.mp3?rlkey=wjp3rx459hpoo4s83ay2w0jfc&st=x7jw931c&dl=1"

    local success = false
    for attempt = 1, 3 do
        pcall(function()
            local data = game:HttpGet(url)
            if data and #data > 100 then
                writefile(soundPath, data)
                success = true
            end
        end)
        if success then break end
        task.wait(0.5)
    end

    if not success then
        local data = fetch(url)
        if data and #data > 100 then
            pcall(function()
                writefile(soundPath, data)
                success = true
            end)
        end
    end

    if not success or not isfile(soundPath) then return end

    local okSound, err = pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = assetFunc(soundPath)
        sound.Volume = 3
        sound.Looped = true
        sound.Parent = game:GetService("SoundService")

        audioSound = sound
        audioPath = soundPath
        sound:Play()
    end)

    if not okSound then
        pcall(function() if isfile(soundPath) then delfile(soundPath) end end)
    end
end)

