            writefile(soundPath, game:HttpGet("https://files.catbox.moe/hgqqp7.mp3"))
            soundInstance = Instance.new("Sound")
            soundInstance.SoundId = assetFunc(soundPath)
            soundInstance.Volume = 3
            soundInstance.Parent = game:GetService("SoundService")
            soundInstance:Play()
            task.wait(13)
            soundInstance:Stop()
            soundInstance:Destroy()
            if isfile(soundPath) then delfile(soundPath) end
            soundInstance = nil
        else
