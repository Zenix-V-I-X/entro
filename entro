local function AntiSpy()
    local player = Players.LocalPlayer
    local PlayerGui = player:WaitForChild("PlayerGui")

    local blacklistedGUIs = {
        ["SimpleSpy2"] = true, ["SimpleSpy1"] = true, ["SimpleSpy"] = true,
        ["Spy"] = true, ["Simple_Spy"] = true, ["Simple-Spy"] = true,
        ["RemoteSpy"] = true, ["Remote_Spy"] = true, ["Remote-Spy"] = true,
        ["RemotesSpy"] = true, ["Remotes_Spy"] = true, ["Remotes-Spy"] = true,
        ["Remotes"] = true, ["Remote"] = true,
    }
    for i = 3, 20 do
        blacklistedGUIs["SimpleSpy"..i] = true
        blacklistedGUIs["Spy"..i]       = true
    end

    local function checkGui(child)
        if blacklistedGUIs[child.Name] then
            Players.LocalPlayer:Kick("Anti-Spy: Removed spy GUI")
        end
    end

    for _, gui in pairs(CoreGui:GetChildren())   do checkGui(gui) end
    for _, gui in pairs(PlayerGui:GetChildren()) do checkGui(gui) end
    CoreGui.ChildAdded:Connect(checkGui)
    PlayerGui.ChildAdded:Connect(checkGui)
end

local carouselRunning = false
local currentIndex = 1
local TRANS_TIME = 0.8

local function ShowImage(index)
    local im = imageLabels[index]
    if not im or not im.Parent then return end
    im.ZIndex = 2
    TweenService:Create(im, TweenInfo.new(TRANS_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        ImageTransparency = 0
    }):Play()

    local data = BG_IDS[index]
    local targetTrans = data.dark and 0.8 or 1
    TweenService:Create(BgDarkOverlay, TweenInfo.new(TRANS_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = targetTrans
    }):Play()
end

local function HideImage(index, isFinalReset)
    local im = imageLabels[index]
    if not im or not im.Parent then return end
    TweenService:Create(im, TweenInfo.new(TRANS_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        ImageTransparency = 1
    }):Play()

    if isFinalReset then
        task.delay(TRANS_TIME, function()
            if im and im.Parent then
                im.ZIndex = 1
            end
        end)
    end
end

local function TransitionToNext()
    if not carouselRunning then return end
    local prevIndex = currentIndex
    currentIndex = currentIndex + 1
    if currentIndex > #BG_IDS then currentIndex = 1 end

    ShowImage(currentIndex)
    HideImage(prevIndex, true)

    task.delay(TRANS_TIME, function()
        local cur = imageLabels[currentIndex]
        if cur and cur.Parent then
            cur.ZIndex = 1
        end
    end)
end

local function StartCarousel()
    if carouselRunning then return end
    carouselRunning = true

    task.spawn(function()
        while carouselRunning do
            task.wait(5)
            if not carouselRunning then break end
            TransitionToNext()
        end
    end)
end

local function LoadScriptAndExit(url, scriptType)
    carouselRunning = false
    StopAndDeleteMusic()
    AntiSpy()

    MainScreen.Visible = false
    InfoScreen.Visible = false

    StarImage.ZIndex = 100

    local moveTween = TweenService:Create(StarImage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position    = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
    })
    moveTween:Play()
    moveTween.Completed:Wait()

    TweenService:Create(starRotationSpeed, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Value = 18
    }):Play()

    TweenService:Create(StarImage, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 2000, 0, 2000)
    }):Play()

    task.delay(0.6, function()
        local fadeTime = 0.6
        local fadeInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        TweenService:Create(StarImage,  fadeInfo, { ImageTransparency  = 1 }):Play()
        TweenService:Create(starStroke, fadeInfo, { Transparency       = 1 }):Play()

        for _, im in ipairs(imageLabels) do
            if im and im.Parent then
                pcall(function()
                    TweenService:Create(im, fadeInfo, { ImageTransparency = 1 }):Play()
                end)
            end
        end

        TweenService:Create(BgDarkOverlay, fadeInfo, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(DarkOverlay,   fadeInfo, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(SolidBlackBG,  fadeInfo, { BackgroundTransparency = 1 }):Play()

        TweenService:Create(BlurEffect, TweenInfo.new(0.8, Enum.EasingStyle.Quad), { Size = 40 }):Play()

        task.delay(fadeTime, function()
            pcall(function() BlurEffect:Destroy() end)
            pcall(function() ScreenGui:Destroy() end)

            task.spawn(function()
                if scriptType == "encrypt" then
                    loadstring(game:HttpGet(url))("9012111915890")
                else
                    loadstring(game:HttpGet(url))()
                end
            end)
        end)
    end)
end

