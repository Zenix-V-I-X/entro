local function stopSound()
    pcall(function()
        if soundInstance then
            soundInstance:Stop()
            soundInstance:Destroy()
            soundInstance = nil
        end
        local sounds = game:GetService("SoundService"):GetChildren()
        for _, sound in ipairs(sounds) do
            if sound:IsA("Sound") then
                sound:Stop()
                sound:Destroy()
            end
        end
    end)
end

local function breakButtons()
    local directions = {
        {X = -300, Y = -200, Rot = -45},
        {X = 300, Y = -180, Rot = 45},
        {X = -250, Y = 250, Rot = 30},
        {X = 250, Y = 230, Rot = -30}
    }
    for i, btn in ipairs(buttons) do
        local dir = directions[i % #directions + 1]
        local xOff = (math.random() * 200 - 100) + dir.X
        local yOff = (math.random() * 200 - 100) + dir.Y
        local rot = dir.Rot + (math.random() * 40 - 20)
        TweenService:Create(btn, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(btn.Position.X.Scale, btn.Position.X.Offset + xOff, btn.Position.Y.Scale, btn.Position.Y.Offset + yOff),
            Rotation = rot,
            BackgroundTransparency = 1,
            TextTransparency = 1
        }):Play()
        TweenService:Create(btn, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0.1, 0, 0.1, 0)
        }):Play()
    end
    task.wait(0.3)
    for _, btn in ipairs(buttons) do
        btn.Visible = false
    end
end

local function exitWithZoom(instant)
    if isExiting then return end
    isExiting = true
    ClickSound:Play()
    stopSound()

    if instant then
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
        end)
        IntroGui:Destroy()
        return
    end

    breakButtons()

    local targetAnchor = Vector2.new(0.5, 0.5)
    local targetPos = UDim2.new(0.5, 0, 0.5, 0)

    local moveTween = TweenService:Create(CenterImage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        AnchorPoint = targetAnchor,
        Position = targetPos
    })

    moveTween:Play()
    moveTween.Completed:Wait()

    TweenService:Create(ButtonContainer, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 1.2, 0)
    }):Play()

    TweenService:Create(rotationSpeedVal, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Value = 18
    }):Play()

    local scaleTween = TweenService:Create(CenterImage, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 2000, 0, 2000)
    })
    scaleTween:Play()

    task.delay(0.6, function()
        local fadeTime = 0.6
        local fadeTweenInfo = TweenInfo.new(fadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        TweenService:Create(CenterImage, fadeTweenInfo, {ImageTransparency = 1}):Play()
        TweenService:Create(Background, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(DarkOverlay, fadeTweenInfo, {BackgroundTransparency = 1}):Play()

        task.delay(fadeTime, function()
            pcall(function()
                StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
            end)
            IntroGui:Destroy()
        end)
    end)
end

