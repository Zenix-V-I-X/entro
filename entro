local function AntiSpy()
    local player = Players.LocalPlayer
    local PlayerGui = player:WaitForChild("PlayerGui")

    local blacklistedGUIs = {
        ["SimpleSpy2"] = true, ["SimpleSpy1"] = true, ["SimpleSpy"] = true,
        ["Spy"] = true, ["Simple_Spy"] = true, ["Simple-Spy"] = true,
        ["RemoteSpy"] = true, ["Remote_Spy"] = true, ["Remote-Spy"] = true,
        ["RemotesSpy"] = true, ["Remotes_Spy"] = true, ["Remotes-Spy"] = true,
        ["Remotes"] = true, ["Remote"] = true,
    }
    for i = 3, 20 do
        blacklistedGUIs["SimpleSpy"..i] = true
        blacklistedGUIs["Spy"..i]       = true
    end

    local function checkGui(child)
        if blacklistedGUIs[child.Name] then
            Players.LocalPlayer:Kick("Anti-Spy: Removed spy GUI")
        end
    end

    for _, gui in pairs(CoreGui:GetChildren())   do checkGui(gui) end
    for _, gui in pairs(PlayerGui:GetChildren()) do checkGui(gui) end
    CoreGui.ChildAdded:Connect(checkGui)
    PlayerGui.ChildAdded:Connect(checkGui)
end

local function TransitionToNext()
    if not carouselRunning then return end

    local prevIndex = currentIndex
    currentIndex = currentIndex + 1
    if currentIndex > #BG_IDS then currentIndex = 1 end

    local newIm = imageLabels[currentIndex]
    local oldIm = imageLabels[prevIndex]

    if not newIm or not newIm.Parent then return end
    if not oldIm or not oldIm.Parent then return end

    newIm.ZIndex = 2
    newIm.ImageTransparency = 1

    TweenService:Create(newIm, TweenInfo.new(TRANS_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        ImageTransparency = 0
    }):Play()

    task.delay(TRANS_TIME, function()
        if not oldIm or not oldIm.Parent then return end
        TweenService:Create(oldIm, TweenInfo.new(TRANS_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            ImageTransparency = 1
        }):Play()

        task.delay(TRANS_TIME, function()
            if oldIm and oldIm.Parent then
                oldIm.ZIndex = 1
            end
            if newIm and newIm.Parent then
                newIm.ZIndex = 1
            end
        end)
    end)
end

local function StartCarousel()
    if carouselRunning then return end
    carouselRunning = true

    task.spawn(function()
        while carouselRunning do
            task.wait(5)
            if not carouselRunning then break end
            TransitionToNext()
        end
    end)
end

local function LoadScriptAndExit(url, scriptType)
