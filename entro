local SONG_FOLDER     = "Sounds"
local currentSound    = nil
local currentSoundPath = nil
local playToken       = 0

local function KillCurrentSound()
    local s = currentSound
    local p = currentSoundPath
    currentSound = nil
    currentSoundPath = nil
    if s then
        pcall(function() s:Stop() end)
        pcall(function() s:Destroy() end)
    end
    if p and isfile(p) then
        pcall(function() delfile(p) end)
    end
end

local function PlaySongByIndex(index)
    local song = SONGS[index]
    if not song or not song.url then return end

    playToken = playToken + 1
    local myToken = playToken

    KillCurrentSound()

    task.spawn(function()
        pcall(function()
            local folder = SONG_FOLDER
            local fileName = tostring(os.time()) .. ".mp3"
            local soundPath = folder .. "/" .. fileName

            local assetFunc = getsynasset or getcustomasset

            if not assetFunc then
                return
            end

            if not isfolder(folder) then
                makefolder(folder)
            end

            writefile(
                soundPath,
                game:HttpGet(song.url)
            )

            if playToken ~= myToken then
                pcall(function() if isfile(soundPath) then delfile(soundPath) end end)
                return
            end

            local sound = Instance.new("Sound")
            sound.SoundId = assetFunc(soundPath)
            sound.Volume = 3
            sound.Looped = true
            sound.Parent = game:GetService("SoundService")

            sound:Play()

            if playToken == myToken then
                currentSound     = sound
                currentSoundPath = soundPath
            else
                pcall(function() sound:Stop() sound:Destroy() end)
                pcall(function() if isfile(soundPath) then delfile(soundPath) end end)
            end
        end)
    end)
end

