    TweenService:Create(InfoBtn,   fadeOutAll, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()

    for _, im in ipairs(imageLabels) do
        if im and im.Parent then
            pcall(function()
                TweenService:Create(im, fadeOutAll, { ImageTransparency = 1 }):Play()
            end)
        end
    end

    TweenService:Create(BgDarkOverlay, fadeOutAll, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(DarkOverlay,   fadeOutAll, { BackgroundTransparency = 1 }):Play()

    if not musicPersistEnabled then
