local starAnimBusy = false

local function AnimateStar(target)
    if starAnimBusy then return end
    starAnimBusy = true
    task.spawn(function()
        local targetPos = (target == "menu") and infoOpenPos or starOriginalPosition
        local isReturn = (target == "home")

        local fadeOutTime = isReturn and 0.9 or 0.18
        local fadeInTime  = isReturn and 1.0 or 0.22

        local fadeOutInfo = TweenInfo.new(fadeOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local t1 = TweenService:Create(StarImage,  fadeOutInfo, { ImageTransparency = 1 })
        local t2 = TweenService:Create(starStroke, fadeOutInfo, { Transparency      = 1 })
        t1:Play(); t2:Play()
        t1.Completed:Wait()

        StarImage.Position = targetPos

        local fadeInInfo = TweenInfo.new(fadeInTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local t3 = TweenService:Create(StarImage,  fadeInInfo, { ImageTransparency = 0 })
        local t4 = TweenService:Create(starStroke, fadeInInfo, { Transparency      = 0 })
        t3:Play(); t4:Play()
        t3.Completed:Wait()

        starAnimBusy = false
    end)
end

