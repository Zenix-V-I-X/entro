local songButtons = {}
local songOn = {}
for i = 1, #SONGS do songOn[i] = false end

local function RefreshSongToggles()
    for i, btn in pairs(songButtons) do
        if btn and btn.Parent then
            local toggleCircle = btn:FindFirstChild("SongToggle")
            local toggleIcon   = toggleCircle and toggleCircle:FindFirstChild("SongIcon")
            if toggleCircle then
                if songOn[i] then
                    toggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    if toggleIcon then
                        toggleIcon.Visible    = true
                        toggleIcon.TextColor3 = Color3.fromRGB(0, 0, 0)
                    end
                else
                    toggleCircle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    if toggleIcon then
                        toggleIcon.Visible = false
                    end
                end
            end
        end
    end
end

local function ToggleSongAt(index)
    pcall(function()
        if songOn[index] then
            songOn[index] = false
            playToken = playToken + 1
            KillCurrentSound()
        else
            for i = 1, #SONGS do songOn[i] = false end
            songOn[index] = true
            PlaySongByIndex(index)
        end
    end)
    RefreshSongToggles()
end

